<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_deep" android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/btnBack" android:layout_width="40dp"
            android:layout_height="40dp" android:src="?attr/homeAsUpIndicator"
            android:background="@android:color/transparent"
            android:contentDescription="Back" android:tint="@color/text_main" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Compose" android:textSize="18sp"
            android:textStyle="bold" android:textColor="@color/text_main"
            android:layout_marginStart="8dp" />
        <Button android:id="@+id/btnSend" android:layout_width="wrap_content"
            android:layout_height="42dp" android:text="Send" android:textSize="14sp"
            android:textColor="@color/text_main" android:background="@drawable/gradient_btn"
            android:textAllCaps="false" android:paddingStart="22dp" android:paddingEnd="22dp" />
    </LinearLayout>

    <TextView android:id="@+id/tvFrom" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="12sp"
        android:textColor="@color/text_dim" android:layout_marginTop="14dp" />

    <EditText android:id="@+id/etTo" android:layout_width="match_parent"
        android:layout_height="50dp" android:hint="To" android:inputType="textEmailAddress"
        android:textColor="@color/text_main" android:textColorHint="@color/text_dim"
        android:background="@drawable/input_bg" android:paddingStart="14dp"
        android:paddingEnd="14dp" android:layout_marginTop="10dp" />

    <EditText android:id="@+id/etCc" android:layout_width="match_parent"
        android:layout_height="50dp" android:hint="Cc (optional, comma separated)"
        android:inputType="textEmailAddress" android:textColor="@color/text_main"
        android:textColorHint="@color/text_dim" android:background="@drawable/input_bg"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginTop="10dp" />

    <EditText android:id="@+id/etSubject" android:layout_width="match_parent"
        android:layout_height="50dp" android:hint="Subject" android:inputType="textCapSentences"
        android:textColor="@color/text_main" android:textColorHint="@color/text_dim"
        android:background="@drawable/input_bg" android:paddingStart="14dp"
        android:paddingEnd="14dp" android:layout_marginTop="10dp" />

    <EditText android:id="@+id/etBody" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:hint="Type your message..."
        android:gravity="top" android:inputType="textCapSentences|textMultiLine"
        android:textColor="@color/text_main" android:textColorHint="@color/text_dim"
        android:background="@drawable/input_bg" android:padding="14dp"
        android:layout_marginTop="10dp" android:layout_marginBottom="10dp" />
</LinearLayout>
